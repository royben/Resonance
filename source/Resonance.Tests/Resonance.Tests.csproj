<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows-targeted on purpose: the suite exercises the named pipes, shared memory
      and USB/WMI adapters, which are Windows-only. Declaring that here is honest and
      resolves CA1416 properly instead of suppressing it. CI already runs windows-latest.
    -->
    <TargetFramework>$(ResonanceWindowsTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Seq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resonance\Resonance.csproj" />
    <ProjectReference Include="..\Resonance.Bluetooth\Resonance.Bluetooth.csproj" />
    <ProjectReference Include="..\Resonance.LZ4\Resonance.LZ4.csproj" />
    <ProjectReference Include="..\Resonance.MessagePack\Resonance.MessagePack.csproj" />
    <ProjectReference Include="..\Resonance.Messages\Resonance.Messages.csproj" />
    <ProjectReference Include="..\Resonance.Protobuf\Resonance.Protobuf.csproj" />
    <ProjectReference Include="..\Resonance.SignalR\Resonance.SignalR.csproj" />
    <ProjectReference Include="..\Resonance.USB\Resonance.USB.csproj" />
    <ProjectReference Include="..\Resonance.WebRTC\Resonance.WebRTC.csproj" />
  </ItemGroup>

</Project>
