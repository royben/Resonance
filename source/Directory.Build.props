<Project>

  <!--
    Single place to bump the target framework for the whole repository.
    Moving to .NET 10 is a one-line change here.
  -->
  <PropertyGroup>
    <ResonanceTfm>net9.0</ResonanceTfm>
    <ResonanceWindowsTfm>$(ResonanceTfm)-windows</ResonanceWindowsTfm>
    <ResonanceAndroidTfm>$(ResonanceTfm)-android</ResonanceAndroidTfm>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <NoWarn>$(NoWarn);1701;1702;1591</NoWarn>
    <!-- Projects opt in individually; keeps examples and tests off the NuGet feed. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Must live in .props: the SDK converts GenerateDocumentationFile into DocumentationFile
    before Directory.Build.targets is imported, so setting it there is too late to
    land the .xml in the package.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Shared NuGet metadata. Individual packages override Description and PackageTags. -->
  <PropertyGroup>
    <!--
      Local default only - the pipeline overrides this with -p:Version.
      Latest published on nuget.org is 1.8.0; 2.0.0 reflects the breaking changes
      (.NET Framework, .NET Standard 2.0 and legacy ASP.NET SignalR support removed).
    -->
    <Version>2.0.0</Version>
    <Authors>Roy Ben Shabat</Authors>
    <Company>Roy Ben Shabat</Company>
    <Copyright>Copyright © Roy Ben Shabat</Copyright>
    <PackageProjectUrl>https://github.com/royben/Resonance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/royben/Resonance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>Communication;RealTime;Network;TCP;UDP;NamedPipes;USB;WebRTC;SignalR;Bluetooth</PackageTags>
  </PropertyGroup>

</Project>
