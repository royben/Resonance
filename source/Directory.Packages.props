<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Runtime-aligned packages track $(ResonanceTfm). When bumping the TFM in
    Directory.Build.props, bump these 9.0.x versions to match.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.18" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.18" />
    <PackageVersion Include="System.IO.Ports" Version="9.0.18" />
    <PackageVersion Include="System.Management" Version="9.0.18" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.18" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="9.0.18" />
  </ItemGroup>

  <!-- Transcoding / compression -->
  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <!-- Adapters -->
  <ItemGroup>
    <PackageVersion Include="InTheHand.Net.Bluetooth" Version="4.2.4" />
    <PackageVersion Include="SIPSorcery" Version="10.0.13" />
  </ItemGroup>

  <!-- Logging (examples and tests) -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <!-- Test / benchmark tooling -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- WPF examples -->
  <ItemGroup>
    <PackageVersion Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <!-- MAUI sample -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
