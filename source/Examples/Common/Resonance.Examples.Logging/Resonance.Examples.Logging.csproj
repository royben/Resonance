<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform Serilog glue shared by the WPF, console, ASP.NET Core and MAUI samples.
    Kept separate from Resonance.Examples.Common so non-Windows samples can use it.
  -->
  <PropertyGroup>
    <TargetFramework>$(ResonanceTfm)</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Resonance.Examples.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Resonance\Resonance.csproj" />
  </ItemGroup>

</Project>
